# Quorum gateway configuration.
# Copy to .env and fill in. The gateway refuses to start without the first three,
# because a resolver that boots without them looks healthy and then fails on the
# first real call — which during a demo is indistinguishable from the product not
# working.

# Which network. "testnet" is Moderato (chain 42431); "mainnet" is 4217.
# Fee sponsorship is only publicly available on testnet.
QUORUM_NETWORK=testnet

# Key for the treasury account that pays wages and refunds. Server-side only.
# On Moderato, fund it from the faucet: https://tempo.xyz/developers/docs/guide/getting-funds
QUORUM_TREASURY_KEY=0x

# Address callers pay when they buy an answer.
QUORUM_RECIPIENT=0x

# Binds payment challenges to their contents. At least 32 bytes.
#   openssl rand -base64 32
MPP_SECRET_KEY=

# Optional.
PORT=8787
QUORUM_PUBLIC_URL=http://localhost:8787
QUORUM_STATE_PATH=data/workers.json
QUORUM_WAGE_CENTS=20
# QUORUM_RPC_URL=https://rpc.moderato.tempo.xyz

# Origins the worker app is served from, comma separated.
QUORUM_WORKER_APP_ORIGINS=http://localhost:5173,http://localhost:5199,http://localhost:4173

# Mounts POST /v1/dev/question, which puts a question in a worker queue without
# payment so the worker app can be exercised. Testnet only, and refused on mainnet
# even if set.
QUORUM_DEV_ENDPOINTS=false

# Optional. Emails a worker who asked to be told, when work in their skills is
# waiting and they are away. Without a key the gateway logs instead of sending.
# RESEND_API_KEY=re_...
# Resend's test sender only delivers to the email address on your Resend
# account. To reach anyone else, verify a domain in Resend and send from it.
# QUORUM_EMAIL_FROM=Quorum <onboarding@resend.dev>
# The link in the email.
# QUORUM_WORKER_APP_URL=http://localhost:4173/app-home

# Optional. Keeps the worker roster in Upstash Redis instead of a local file, so a
# host that wipes its disk on restart (Render's free plan) loses nothing. Use the
# full-access REST token, not the read-only one. The first start moves an existing
# local roster across.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Optional, and used instead of Resend when set. Brevo can send from a single
# verified address with no domain of your own (Brevo > Senders), such as a Gmail.
# BREVO_API_KEY=...
# QUORUM_EMAIL_FROM=Quorum <you@gmail.com>
