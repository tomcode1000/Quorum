{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "QUORUM_GATEWAY_URL=https://api.quorumhq.xyz npm run build -w @quorum/site",
  "outputDirectory": "packages/site/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/",
      "permanent": true
    }
  ]
}
